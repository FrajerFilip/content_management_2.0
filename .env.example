# Poskytovatel: "ollama" (lokální, výchozí) nebo "anthropic"
LLM_PROVIDER=ollama

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_TIMEOUT_MS=300000

# Anthropic (jen pro LLM_PROVIDER=anthropic) — soubor .env nikdy necommituj
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=3000
CORS_ORIGIN=http://localhost:3000
